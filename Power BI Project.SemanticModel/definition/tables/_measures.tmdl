table _measures
	lineageTag: 844193ae-62f2-4cc1-8f82-070aab61b8be

	measure all_net_revenue = CALCULATE(SUM(fact_sales[net_revenue]),ALL())
		lineageTag: 31f6bb6b-eea0-4875-be6b-279648bdadcc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure all_orders = CALCULATE(DISTINCTCOUNT(fact_sales[order_id]), ALL())
		formatString: 0
		lineageTag: b009fbe0-1849-4925-bcfc-f3030c7cebad

	measure revenue_promotedSKUs_inWindow =
			
			SUMX (
			    dim_campaign,
			    VAR StartDate = dim_campaign[start_date]
			    VAR EndDate   = dim_campaign[end_date]
			    VAR PromotedSKUs =
			        CALCULATETABLE ( VALUES ( fact_promotion_coverage[product_key] ) )
			    RETURN
			        CALCULATE (
			            SUM ( fact_sales[net_revenue] ),
			            fact_sales[order_date] >= StartDate,
			            fact_sales[order_date] <= EndDate,
			            KEEPFILTERS ( TREATAS ( PromotedSKUs, dim_product[product_key] ) )
			        )
			)
		formatString: #,0
		lineageTag: 0c0d064e-90d8-40f6-b531-946eecb9efd3

		annotation PBI_FormatHint = {"isDecimal":true}

	measure click_through_rate = ```
			
			DIVIDE(
			    SUM(fact_campaign_spend[clicks]), 
			    SUM(fact_campaign_spend[impressions])
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 250f6fbd-d7d3-4006-a57a-0baf5984bae2

	measure spend_per_budget =
			
			DIVIDE(
			    SUM(fact_campaign_spend[spend]),
			    SUM(dim_campaign[budget])
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6b069d3b-2292-4d72-93e6-adbf5f974578

	measure 'ROAS ratio' =
			
			DIVIDE ( [revenue_promotedSKUs_inWindow], SUM ( fact_campaign_spend[spend] ) )
		formatString: 0.00
		lineageTag: e21b491d-19c4-4ad1-a5a2-501051f8ee47

	measure 'ROI ratio' =
			
			VAR Rev  = [revenue_promotedSKUs_inWindow]
			VAR Cost = [cost_promotedSKUs_inWindow] + SUM ( fact_campaign_spend[spend] )
			RETURN
			    DIVIDE ( Rev - Cost, Cost )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: c03066b0-c01d-4ba5-80ac-dc7d10a89799

	measure all_profit_margin = ```
			
			    DIVIDE(
			        CALCULATE ( SUM ( fact_sales[net_profit] ), ALL() ),
			        [all_net_revenue]
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7e97dd89-8961-4a9e-b49d-ad6ed58c253f

	measure total_revenue = SUM(fact_sales[net_revenue])
		formatString: #,0
		lineageTag: 8794a105-7ed4-471c-8aef-abbedba7f881

		annotation PBI_FormatHint = {"isDecimal":true}

	measure total_profit = SUM(fact_sales[net_profit])
		lineageTag: 95fb9e81-6243-42b0-a2de-d9380808c621

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure total_orders = DISTINCTCOUNT(fact_sales[order_id])
		formatString: 0
		lineageTag: 9056bf2c-770e-4402-9fcf-9d1e1520dbcb

	measure loyal_customers =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customer[customer_id]),
			        VAR avg_revenue = DIVIDE([total_revenue],[total_orders])
			        RETURN
			            [total_revenue] >= [average_order_value]
			    )
			)
		formatString: 0
		lineageTag: d72e5583-3166-4392-b446-588b7648ea65

	measure all_active_customers =
			
			COUNTROWS(
			    FILTER(
			        VALUES(dim_customer[customer_id]),
			        [total_orders] > 0
			    )
			)
		formatString: 0
		lineageTag: b47fde12-7fe0-4fda-92f7-98b52c70d03b

	measure average_order_value = DIVIDE([all_net_revenue],[all_orders])
		lineageTag: 9e30cb79-262c-4d9c-841f-249e6e7941c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'forecast sales' =
			
			VAR CurrentDate = MAX ( dim_date[Date] )
			VAR LastSaleDate =
			    CALCULATE ( MAX ( fact_sales[order_date] ), ALL ( dim_date ) )
			RETURN
			    IF (
			        ISBLANK ( [total_revenue] ) && CurrentDate > LastSaleDate && YEAR(CurrentDate) = 2026,
			        AVERAGEX (
			            DATESINPERIOD ( dim_date[Date], LastSaleDate, -3, MONTH ),
			            CALCULATE ( [total_revenue] )
			        )
			    )
		lineageTag: b87dde44-63a8-452a-8586-a94f3953608d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top Products Revenue' = ```
			
			    CALCULATE ( 
			        [total_revenue], 
			        KEEPFILTERS ( 
			            TREATAS ( TopProducts, dim_product[category], 
			            dim_product[product_name] 
			        ) 
			    ) 
			)
			```
		formatString: #,0
		lineageTag: e6618a4c-2dbc-41d5-88b9-4ed243a706b0

		annotation PBI_FormatHint = {"isDecimal":true}

	measure total_quantity = SUM(fact_sales[quantity])
		formatString: 0
		lineageTag: 2fd2800b-d677-40ee-9c24-e86bc8143d9b

	measure 'Revenue Pct' =
			
			VAR VisibleRevenue =
			    SUMX ( VALUES ( dim_campaign[campaign_name] ), [revenue_promotedSKUs_inWindow] )
			VAR AllCampaignsRevenue =
			    SUMX ( ALL( dim_campaign[campaign_name] ), [total_revenue] )
			RETURN
			    DIVIDE ( VisibleRevenue, AllCampaignsRevenue )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ce1acd2f-6789-42e4-9579-9818568c1a2b

	measure cost_promotedSKUs_inWindow =
			
			SUMX (
			    dim_campaign,
			    VAR StartDate = dim_campaign[start_date]
			    VAR EndDate   = dim_campaign[end_date]
			    VAR PromotedSKUs =
			        CALCULATETABLE ( VALUES ( fact_promotion_coverage[product_key] ) )
			    RETURN
			        CALCULATE (
			            SUMX ( fact_sales, fact_sales[quantity] * fact_sales[cost] ),
			            fact_sales[order_date] >= StartDate,
			            fact_sales[order_date] <= EndDate,
			            KEEPFILTERS ( TREATAS ( PromotedSKUs, dim_product[product_key] ) )
			        )
			)
		lineageTag: bb631ea6-47c0-43d5-9594-7c5d07163684

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'sales YTD' = CALCULATE ( [total_revenue], DATESYTD ( dim_date[Date] ) )
		lineageTag: 60f0fb4a-40a6-405a-9d60-131ce527b946

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'sales QTD' = CALCULATE ( [total_revenue], DATESQTD ( dim_date[Date] ) )
		lineageTag: af8f0e50-92ec-4836-abff-b89c21eb8f6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'sales YoYTD %' = ```
			
			VAR CurrentYTD = [sales YTD]
			VAR PreviousYearYTD = 
			    CALCULATE ( [Sales YTD], DATEADD ( dim_date[Date], -1, YEAR ) )
			RETURN
			    DIVIDE ( CurrentYTD - PreviousYearYTD, PreviousYearYTD )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b15c16ed-b514-4203-ac06-24a07511c32c

	measure 'sales YoQTD %' = ```
			
			VAR CurrentQTD = [Sales QTD]
			VAR PreviousYearQTD = 
			    CALCULATE ( [Sales QTD], DATEADD ( dim_date[Date], -1, YEAR ) )
			RETURN
			    DIVIDE ( CurrentQTD - PreviousYearQTD, PreviousYearQTD )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d6b71fa1-91fc-4b5c-80fe-f2514a19e3ad

	measure 'sales QoYTD %' = ```
			
			VAR CurrentYTD = [Sales YTD]
			VAR PreviousQuarterYTD = 
			    CALCULATE ( [Sales YTD], DATEADD ( dim_date[Date], -1, QUARTER ) )
			RETURN
			    DIVIDE( CurrentYTD - PreviousQuarterYTD, PreviousQuarterYTD )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5a78504e-c982-4eb7-b7cb-35ac3ece89ce

	measure 'sales QoQTD %' =
			
			VAR CurrentQTD = [Sales QTD]
			VAR PreviousQuarterQTD =
			    CALCULATE ( [Sales QTD], DATEADD ( dim_date[Date], -1, QUARTER ) )
			RETURN
			    DIVIDE ( CurrentQTD - PreviousQuarterQTD, PreviousQuarterQTD )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7359f06a-f396-4915-be52-4a367c2c6f9c

	measure 'Top profit margin' = ```
			
			VAR TopProductsProfit = 
			    CALCULATE ( 
			        [total_profit], 
			        KEEPFILTERS ( 
			            TREATAS ( TopProducts, dim_product[category], 
			            dim_product[product_name] 
			        ) 
			    ) 
			)
			RETURN
			    DIVIDE( TopProductsProfit , [Top Products Revenue] )
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 35d2ec01-3dec-416d-9002-2c58224de4e1

	measure 'Profit margin' = DIVIDE( [total_profit], [total_revenue] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a6ac86a0-3b9d-4462-82aa-92264a7f03ce

	column Column
		isHidden
