	hierarchy 'Year Hierarchy'
		lineageTag: cb31c26e-df27-404b-b4aa-bf179f7384c8

		level Year
			lineageTag: aa98fc52-5ad7-4fa1-8deb-e58ad5dba77b
			column: Year

		level 'Year Quarter'
			lineageTag: a98a102c-bdfc-4180-9ae4-4464b964b654
			column: 'Year Quarter'

		level 'Year Month'
			lineageTag: b9194309-11bd-4de5-a1d2-584461d30ac3
			column: 'Year Month'

		level 'Year Week'
			lineageTag: f96416c3-495e-4758-a9c7-ce6ad675edfd
			column: 'Year Week'

	partition dim_date = calculated
		mode: import
		source =
				
				VAR MinYear = YEAR ( MIN ( fact_sales[order_date] ) )
				VAR MaxYear = YEAR ( MAX ( fact_sales[order_date] ) )
				RETURN
				    ADDCOLUMNS (
				        FILTER (
				            CALENDARAUTO ( ),
				            YEAR ( [Date] ) >= MinYear &&
				            YEAR ( [Date] ) <= MaxYear
				        ),
				    "Year", YEAR ( [Date] ),
				    "Quarter Number", INT ( FORMAT ( [Date], "q" ) ),
				    "Quarter", "Q" & INT ( FORMAT ( [Date], "q" ) ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm" ),
				    "Week Number", WEEKNUM ( [Date], 2 ),
				    "ISO Year", YEAR ( [Date] + 3 - MOD ( WEEKDAY ( [Date], 2 ) - 1, 7 ) ),
				    "ISO Week", WEEKNUM ( [Date], 21 ),
				    "Year Week Number", YEAR ( [Date] + 3 - MOD ( WEEKDAY ( [Date], 2 ) - 1, 7 ) ) * 100 + WEEKNUM ( [Date], 21 ),
				    "Year Week", "W" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ) & "-" & YEAR ( [Date] + 3 - MOD ( WEEKDAY ( [Date], 2 ) - 1, 7 ) ),
				    "Week Day Number", WEEKDAY ( [Date] ,2),
				    "Week Day", FORMAT ( [Date], "ddd" ),
				    "Year Month Number", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Year Month", FORMAT ( [Date], "mmm" ) & " " & YEAR ( [Date] ),
				    "Year Quarter Number", YEAR ( [Date] ) * 100 + INT ( FORMAT ( [Date], "q" ) ),
				    "Year Quarter", "Q" & FORMAT ( [Date], "q" ) & "-" & YEAR ( [Date] )
				    )

	annotation PBI_Id = 3f1432588def42958fc8f0e5e236a135

